---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Guestbook" description="ฝากข้อความทักทายไว้ที่ guestbook">
  <section class="card">
    <h1>Guestbook</h1>
    <p>ฝากข้อความไว้ได้ทางฟอร์มนี้ — อ่าน/เขียนผ่าน <code>/api/guestbook</code></p>
    <form id="gb-form">
      <label for="name">Name</label>
      <input id="name" name="name" required maxlength="80" />
      <label for="message">Message</label>
      <textarea id="message" name="message" rows="3" required maxlength="500"></textarea>
      <p style="margin-top:1rem">
        <button type="submit">Sign</button>
      </p>
      <p id="gb-status" role="status" aria-live="polite"></p>
    </form>
    <div id="entries" class="card" style="margin-top:1.25rem" aria-live="polite">Loading…</div>
  </section>
</BaseLayout>
<script>
  const entries = document.getElementById('entries');
  const form = document.getElementById('gb-form');
  const status = document.getElementById('gb-status');

  function renderEntries(rows: { name: string; message: string; created_at: string }[]) {
    entries.replaceChildren();
    if (!rows.length) {
      const empty = document.createElement('p');
      empty.textContent = 'No entries yet.';
      entries.append(empty);
      return;
    }
    const list = document.createElement('ul');
    for (const e of rows) {
      const li = document.createElement('li');
      const strong = document.createElement('strong');
      strong.textContent = e.name;
      const small = document.createElement('small');
      small.textContent = e.created_at;
      li.append(strong, `: ${e.message}`, document.createElement('br'), small);
      list.append(li);
    }
    entries.append(list);
  }

  async function load() {
    const res = await fetch('/api/guestbook');
    const data = await res.json();
    if (!res.ok) {
      entries.textContent = data.error || `HTTP ${res.status}`;
      return;
    }
    renderEntries(data.entries || []);
  }
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const payload = Object.fromEntries(new FormData(form).entries());
    status.textContent = 'Sending…';
    try {
      const res = await fetch('/api/guestbook', {
        method: 'POST',
        headers: { 'content-type': 'application/json' },
        body: JSON.stringify(payload),
      });
      const data = await res.json();
      if (!res.ok) {
        status.textContent = `Error: ${data.error || res.status}`;
        return;
      }
      status.textContent = 'Signed. Thank you!';
      form.reset();
      await load();
    } catch (err) {
      status.textContent = 'Network error';
    }
  });
  load();
</script>

