---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout
  title={`Contact · ${profile.name}`}
  description={`ช่องทางติดต่อ ${profile.name} — email และ GitHub`}
>
  <section class="card">
    <h1>Contact</h1>
    <p>ทักมาได้เลยถ้าสนใจคุยเรื่องงาน หรืออยากแลกเปลี่ยนเรื่อง AI agents / web development</p>
    {profile.contact.email && (
      <p>
        <strong>Email:</strong>{' '}
        <a href={`mailto:${profile.contact.email}`}>{profile.contact.email}</a>
      </p>
    )}
    {profile.contact.github && (
      <p>
        <strong>GitHub:</strong>{' '}
        <a href={profile.contact.github} target="_blank" rel="noopener noreferrer">
          {profile.contact.github}
        </a>
      </p>
    )}
  </section>
</BaseLayout>
