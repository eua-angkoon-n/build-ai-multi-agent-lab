---
export const prerender = false;
import BaseLayout from '../layouts/BaseLayout.astro';
import { loadProfile } from '../lib/profile';
const profile = loadProfile();
---
<BaseLayout
  title={`About · ${profile.name}`}
  description={`เรื่องราวและเส้นทางการทำงานของ ${profile.name}`}
>
  <article class="card">
    <h1>About</h1>
    <p>{profile.bio}</p>
    <p>
      มุมที่เลือกเล่าคือแบบ problem-first ไม่ใช่ tool-first — เริ่มจากปัญหางานจริงที่เจอ
      แล้วดูว่า AI agent เข้ามาช่วยแก้ตรงไหนได้บ้าง แทนที่จะพูดถึงเครื่องมือลอย ๆ
      ยังอยู่ในช่วงเรียนรู้และลงมือทดลองจริงอยู่ ไม่ได้บอกว่าเชี่ยวชาญครบทุกด้านแล้ว
    </p>
  </article>
</BaseLayout>

