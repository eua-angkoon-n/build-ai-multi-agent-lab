---
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Personal Site', description = 'Personal branding site' } = Astro.props;
---
<!doctype html>
<html lang="th">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <style is:global>
      :root {
        --bg: #f6f1e7;
        --card: #fffdf8;
        --text: #3d3226;
        --muted: #6b5c4d;
        --accent: #9c4221;
        --border: #e5d8c3;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: "Segoe UI", system-ui, sans-serif;
        background: radial-gradient(circle at top, var(--card), var(--bg) 60%);
        color: var(--text);
        min-height: 100vh;
      }
      a { color: var(--accent); text-decoration: none; }
      a:hover { text-decoration: underline; }
      main { width: min(920px, 92vw); margin: 0 auto; padding: 2rem 0 4rem; }
      .card {
        background: var(--card);
        border: 1px solid var(--border);
        border-radius: 16px;
        padding: 1.25rem 1.5rem;
        margin: 1rem 0;
        box-shadow: 0 1px 3px rgba(61, 50, 38, 0.06);
      }
      nav {
        display: flex; gap: 1rem; flex-wrap: wrap;
        width: min(920px, 92vw); margin: 0 auto; padding: 1.25rem 0;
        border-bottom: 1px solid var(--border);
      }
      nav a { color: var(--muted); font-weight: 600; }
      nav a[aria-current="page"] { color: var(--text); }
      h1, h2 { line-height: 1.2; }
      p, li { color: var(--muted); line-height: 1.6; }
      #entries ul { list-style: none; margin: 0; padding: 0; }
      #entries li { margin: 0.75rem 0; }
      input, textarea, button {
        font: inherit; border-radius: 10px; border: 1px solid var(--border);
        background: var(--card); color: var(--text); padding: 0.7rem 0.9rem; width: 100%;
      }
      button { background: var(--accent); color: var(--bg); font-weight: 700; cursor: pointer; width: auto; }
      label { display: block; margin: 0.75rem 0 0.35rem; color: var(--text); font-weight: 600; }
      .grid { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); }
      .skip-link {
        position: absolute;
        left: -9999px;
        top: 0;
        background: var(--accent);
        color: var(--bg);
        padding: 0.6rem 1rem;
        z-index: 100;
        border-radius: 0 0 8px 0;
        font-weight: 700;
      }
      .skip-link:focus { left: 0; }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link">ข้ามไปเนื้อหาหลัก</a>
    <nav aria-label="หลัก">
      <a href="/" aria-current={Astro.url.pathname === '/' ? 'page' : undefined}>Home</a>
      <a href="/about" aria-current={Astro.url.pathname.startsWith('/about') ? 'page' : undefined}>About</a>
      <a href="/interests" aria-current={Astro.url.pathname.startsWith('/interests') ? 'page' : undefined}>Interests</a>
      <a href="/contact" aria-current={Astro.url.pathname.startsWith('/contact') ? 'page' : undefined}>Contact</a>
      <a href="/guestbook" aria-current={Astro.url.pathname.startsWith('/guestbook') ? 'page' : undefined}>Guestbook</a>
    </nav>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
